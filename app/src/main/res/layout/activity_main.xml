<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/AfishaBody"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/eyebrow"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            style="@style/AfishaBody"
            android:layout_marginTop="4dp"
            android:accessibilityHeading="true"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/AfishaBody"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle" />

        <LinearLayout
            style="@style/AfishaCard"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/AfishaBody"
                android:fontFamily="sans-serif-medium"
                android:labelFor="@+id/mode_spinner"
                android:text="@string/mode_label"
                android:textColor="@color/ink" />

            <Spinner
                android:id="@id/mode_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:spinnerMode="dropdown" />

            <Button
                android:id="@+id/load_button"
                style="@style/AfishaButton"
                android:layout_marginTop="8dp"
                android:text="@string/load" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loading_panel"
            style="@style/AfishaCard"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/accent" />

            <TextView
                style="@style/AfishaBody"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/loading" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/error_panel"
            style="@style/AfishaCard"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_error"
            android:visibility="gone">

            <TextView
                style="@style/AfishaBody"
                android:text="@string/error"
                android:textColor="@color/error_ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/retry_button"
                style="@style/AfishaButton"
                android:layout_marginTop="12dp"
                android:text="@string/retry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty_panel"
            style="@style/AfishaCard"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone">

            <TextView
                style="@style/AfishaBody"
                android:text="@string/empty" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meeting_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
